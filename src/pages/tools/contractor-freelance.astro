---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

const allowedSlugs = [
  'contractor-vs-employee',
  'freelance-rate-calculator',
  'freelance-risk-calculator'
];

const registryPath = path.resolve('tools/registry.json');
const registryData = await fs.readFile(registryPath, 'utf-8');
const registry = JSON.parse(registryData);

const tools = await Promise.all(registry
  .filter((entry: any) => entry.status === 'active' && allowedSlugs.includes(entry.slug))
  .map(async (entry: any) => {
    const defPath = path.resolve(`tools/definitions/${entry.slug}.json`);
    const defData = await fs.readFile(defPath, 'utf-8');
    return { ...entry, definition: JSON.parse(defData) };
  })
);

tools.sort((a, b) => a.priority - b.priority);
---

<Layout title="Contractor & Freelance Economics | Econified" description="Calculate the true value of freelance rates, contractor equivalents, and independent risk." canonicalUrl="https://econified.com/tools/contractor-freelance/">
  <main class="container">
    <nav class="breadcrumb" style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 1rem;">
      <a href="/" style="color: inherit;">Home</a> &rsaquo;
      <a href="/tools/" style="color: inherit;">Tools</a> &rsaquo;
      Contractor & Freelance
    </nav>
    <div style="text-align: left; margin-bottom: 2rem;">
      <h1>Contractor & Freelance Economics</h1>
      <p class="lead">Going independent carries risks, taxes, and missing benefits. Use these tools to figure out a rate based on your own budget and expected billable time.</p>
    </div>

    <section class="glass-panel" style="margin-bottom:3rem;line-height:1.8;"><h2>Start with the decision you face</h2><ol><li><a href="/contractor-vs-employee/">Compare a specific contract with employment</a>: enter offered pay, billable weeks and replacement costs.</li><li><a href="/freelance-rate-calculator/">Build a rate from an annual budget</a>: choose your income target and overhead markup, then divide by paid hours.</li><li><a href="/freelance-risk-calculator/">Check cash runway</a>: see how long available savings cover spending and test fewer billable hours.</li></ol><p>The two rate tools use different overhead conventions: one deducts a share of revenue, the other adds a markup to a target. Read <a href="/guides/freelance-risk-pricing/">the worked comparison</a> before transferring a percentage between them.</p><p>Use actual insurance quotes, business costs and expected paid time. There is no universal contractor premium. US tax context appears in the <a href="/guides/contractor-vs-employee-pay/">contractor pay guide</a>; these tools do not calculate an individual tax return.</p></section>

    <h2 style="margin-bottom: 1.5rem;">Freelance & Contractor Tools</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.5rem;">
      {tools.map((tool: any) => (
        <a href={`/${tool.slug}/`} class="glass-panel" style="display: block; text-decoration: none;">
          <h2 style="color: var(--accent-light); margin-bottom: 0.5rem; font-size: 1.25rem;">{tool.definition.title}</h2>
          <p style="color: var(--text-secondary); margin-bottom: 0; font-size: 0.95rem;">{tool.definition.description}</p>
        </a>
      ))}
    </div>
  </main>
</Layout>
